# Get a key from https://build.nvidia.com (any model page -> "Get API Key")
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the OpenAI-compatible endpoint
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- council roster ----------------------------------------------------
# Any model id from `python -m council.models`. The leader chairs every
# session and writes the verdict; ministers are the senior seats; members are
# the base of the council; bench models show in the UI roster but start
# unseated. Move a model between lists to change its rank.
#
# The lists below mirror the built-in defaults in council/config.py.

# 1 council leader - chairs every session, writes the verdict.
# Not the largest model on the catalog, deliberately: nemotron-3-ultra-550b
# was the original leader and proved unreliable under load (see the comment
# above DEFAULT_CHAIR in council/config.py). It sits as a bench model now.
# Whatever you put here must NOT also appear below - a leader that is also a
# seat ends up weighing an argument it made itself.
COUNCIL_LEADER=z-ai/glm-5.2

# 3 ministers - senior seats, one per lineage
COUNCIL_MINISTERS=openai/gpt-oss-120b,nvidia/nemotron-3-super-120b-a12b,moonshotai/kimi-k2.6

# 9 members - the base of the council
COUNCIL_MEMBERS=deepseek-ai/deepseek-v4-flash-0731,minimaxai/minimax-m3,stepfun-ai/step-3.7-flash,thinkingmachines/inkling,meta/llama-3.3-70b-instruct,meta/muse-glimmer-30b,google/gemma-4-31b-it,mistralai/mistral-large-2-instruct,nvidia/nemotron-3.5-lightning-30b-a3b

# unseated, one tick away in the UI. NOTE: NVIDIA catalog listings don't mean
# your API key can reach a model - many "Partner Endpoint" models 404 with
# "function not found for account" until NVIDIA enables them for your account
# tier. Run `python -m council.models` to see what your key actually reaches.
COUNCIL_BENCH=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-nano-30b-a3b,nvidia/nvidia-nemotron-nano-9b-v2

# Optional: a council.json roster overrides everything above
# COUNCIL_CONFIG=council.json
